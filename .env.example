# Klaviyo API Configuration
KLAVIYO_API_KEY=your_private_api_key_here

# API Settings
KLAVIYO_API_REVISION=2024-02-15

# Rate limiting - seconds between API requests (Klaviyo has strict limits)
# Increase if you get 429 errors
RATE_LIMIT_DELAY=3.0

# Processing Settings
# Minimum sends to include campaign in report
MIN_SENDS_THRESHOLD=20

# Campaigns with fewer sends than this are permanently ignored (not stored, not re-fetched)
IGNORE_SENDS_THRESHOLD=20

# Test mode: only process first N campaigns (0 = all)
TEST_MODE_LIMIT=0

# Output Settings
OUTPUT_DIR=output

# Conversion metric ID for Klaviyo (for tracking sales/revenue)
CONVERSION_METRIC_ID=TKuEA4

# ============================================
# AI ANALYSIS - Set at least one API key
# ============================================

# Anthropic - For Claude Opus/Sonnet analysis
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI - For GPT-4o analysis
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# Google Gemini - For Gemini 1.5 Pro analysis
# Get key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
