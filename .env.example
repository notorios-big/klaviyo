# Klaviyo API Configuration
KLAVIYO_API_KEY=your_private_api_key_here

# API Settings
KLAVIYO_API_REVISION=2024-02-15

# Processing Settings
# Minimum sends to include campaign in report
MIN_SENDS_THRESHOLD=100

# Test mode: only process first N campaigns (0 = all)
TEST_MODE_LIMIT=5

# Output Settings
OUTPUT_DIR=output
OUTPUT_FORMAT=markdown

# Optional: OpenAI for image analysis
# OPENAI_API_KEY=your_openai_key_here

# Optional: Anthropic for image analysis
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Conversion metric ID for Klaviyo
CONVERSION_METRIC_ID=TKuEA4
